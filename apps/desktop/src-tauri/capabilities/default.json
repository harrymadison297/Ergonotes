{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the Ergonotes window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "notification:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "https://*:*"
        },
        {
          "url": "https://*/*"
        },
        {
          "url": "https://*:*/*"
        },
        {
          "url": "http://*"
        },
        {
          "url": "http://*:*"
        },
        {
          "url": "http://*/*"
        },
        {
          "url": "http://*:*/*"
        }
      ]
    }
  ]
}